{
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/rest/v1/:match*",
      "destination": "https://ppehttbtrlavnrytoweu.supabase.co/rest/v1/:match*"
    },
    {
      "source": "/auth/v1/:match*",
      "destination": "https://ppehttbtrlavnrytoweu.supabase.co/auth/v1/:match*"
    },
    {
      "source": "/storage/v1/:match*",
      "destination": "https://ppehttbtrlavnrytoweu.supabase.co/storage/v1/:match*"
    },
    {
      "source": "/functions/v1/:match*",
      "destination": "https://ppehttbtrlavnrytoweu.supabase.co/functions/v1/:match*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
